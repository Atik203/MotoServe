{
  "buildCommand": "pnpm --dir backend db:generate",
  "installCommand": "exit 1",
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/_next/static/(.*)", "dest": "/frontend/_next/static/$1" },
    { "src": "/_next/image(.*)", "dest": "/frontend/_next/image$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
