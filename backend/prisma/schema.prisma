generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADVISOR
  MECHANIC
  OWNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  REJECTED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum ServiceCategory {
  MAINTENANCE
  REPAIRS
  INSPECTIONS
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TaskStatus {
  RECEIVED
  INSPECTING
  REPAIRING
  TESTING
  READY
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EstimateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EstimateItemCategory {
  SERVICE
  PARTS
  LABOR
}

enum SenderRole {
  ADVISOR
  OWNER
}

enum PaymentMethod {
  CARD
  CASH
  MOBILE
}

enum InvoiceStatus {
  PAID
  UNPAID
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role
  phone          String?
  avatar         String?
  station        String?
  specialization String?
  status         UserStatus @default(ACTIVE)
  nid            String?
  drivingLicense String?
  occupation     String?
  street         String?
  city           String?
  district       String?
  zip            String?
  country        String?
  dateOfBirth    DateTime?
  gender         String?
  documentUrl    String?
  documents      Json?
  verifiedAt     DateTime?
  joinedAt       DateTime  @default(now())

  vehicles         Vehicle[]
  appointments     Appointment[]
  taskCardsAdvised TaskCard[]   @relation("AdvisorTasks")
  taskCardsAssigned TaskCard[]  @relation("MechanicTasks")
  taskCardsCustomer TaskCard[]  @relation("CustomerTasks")
  threadsOwned     ChatThread[] @relation("OwnerThreads")
  threadsAdvised ChatThread[] @relation("AdvisorThreads")
  ratings        Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  make         String
  model        String
  year         Int
  regNo        String   @unique
  fuelType     FuelType
  mileage      Int
  vin          String?
  color        String?
  transmission String?
  image        String?
  photos       Json?

  appointments Appointment[]
  taskCards    TaskCard[]
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String          @id @default(cuid())
  name        String
  category    ServiceCategory
  basePrice   Float
  durationMins Int
  description String
  active      Boolean         @default(true)
  marketing   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id         String            @id @default(cuid())
  ownerId    String
  owner      User              @relation(fields: [ownerId], references: [id])
  vehicleId  String
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceIds String[]
  date       String
  time       String
  status     AppointmentStatus @default(PENDING)
  notes      String

  taskCard TaskCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCard {
  id             String     @id
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id])
  customerId     String
  customer       User       @relation("CustomerTasks", fields: [customerId], references: [id])
  advisorId      String
  advisor        User       @relation("AdvisorTasks", fields: [advisorId], references: [id])
  mechanicId     String?
  mechanic       User?      @relation("MechanicTasks", fields: [mechanicId], references: [id])
  station        String?
  assignmentNotes String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus  @default(RECEIVED)
  issues         String
  services       Json?
  photos         Json?
  totalEstimate  Float?
  appointmentId  String?   @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  expectedDate   String?
  mileage        Int?
  fuelLevel      Int?
  keysReceived   Boolean?
  accessories    String?
  ownerArchivedAt DateTime?

  progress       TaskProgress[]
  notes          TaskNote[]
  partsUsed      PartsUsed[]
  estimates      Estimate[]
  invoices       Invoice[]
  ratings        Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskProgress {
  id         String    @id @default(cuid())
  taskCardId String
  taskCard   TaskCard  @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  step       TaskStatus
  label      String
  timestamp  String?
  done       Boolean   @default(false)
}

model TaskNote {
  id         String   @id @default(cuid())
  taskCardId String
  taskCard   TaskCard @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  author     String
  time       String
  text       String
}

model PartsUsed {
  id         String   @id @default(cuid())
  taskCardId String
  taskCard   TaskCard @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  name       String
  qty        Int
  unitPrice  Float
  supplier   String
  subtotal   Float
}

model Part {
  id        String  @id @default(cuid())
  name      String
  sku       String  @unique
  unitPrice Float
  supplier  String
  stock     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Estimate {
  id            String          @id
  taskCardId    String
  taskCard      TaskCard        @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  customerId    String
  advisorId     String
  createdAt     DateTime        @default(now())
  status        EstimateStatus  @default(PENDING)
  summary       String
  internalNotes String?
  total         Float

  items EstimateItem[]
}

model EstimateItem {
  id          String              @id @default(cuid())
  estimateId  String
  estimate    Estimate            @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  category    EstimateItemCategory
  amount      Float
}

model ChatThread {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation("OwnerThreads", fields: [ownerId], references: [id])
  advisorId     String
  advisor       User     @relation("AdvisorThreads", fields: [advisorId], references: [id])
  subject       String
  ownerUnread   Int      @default(0)
  advisorUnread Int      @default(0)
  lastMessageAt DateTime @default(now())

  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender   SenderRole
  text     String
  time     DateTime   @default(now())
}

model Invoice {
  id         String        @id
  taskId     String
  task       TaskCard      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customerId String
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])
  issuedAt   DateTime      @default(now())
  status     InvoiceStatus @default(UNPAID)
  items      Json
  laborTotal Float
  partsTotal Float
  subtotal   Float
  tax        Float
  total      Float
  paymentMethod PaymentMethod?
  last4      String?
  paidAt     DateTime?

  payment Payment?
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String        @unique
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taskCardId String
  amount     Float
  method     PaymentMethod
  status     InvoiceStatus @default(PAID)
  paidAt     DateTime      @default(now())
}

model Rating {
  id          String   @id @default(cuid())
  taskId      String
  task        TaskCard @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  serviceName String
  score       Int
  review      String
  date        DateTime @default(now())

  @@unique([taskId, customerId])
}

model Testimonial {
  id      String  @id @default(cuid())
  name    String
  vehicle String
  rating  Int
  review  String
  date    DateTime @default(now())
}

model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id     String   @id @default(cuid())
  user   String
  action String
  time   DateTime @default(now())
}
