# backend
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motoserve?schema=public"
JWT_SECRET="change-me-in-production"
CLIENT_URL="http://localhost:3500"

# AWS S3 (uploads) — single private bucket, everything under the MotoServe/ prefix
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="scholar-flow-uploads"
AWS_REGION="us-east-1"
S3_ROOT_PREFIX="MotoServe/"

# Stripe (test mode keys — replace with live keys for production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
