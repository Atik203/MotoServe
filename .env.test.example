# Dedicated database used ONLY by the Playwright test suite.
# The suite runs `prisma db push` and the demo seed against it, which DELETES data.
# Never point this at your development database.
#
# Copy this file to `.env.test` (gitignored) and paste a Postgres connection string:
TEST_DATABASE_URL="postgresql://user:password@host:5432/motoserve_test?sslmode=verify-full"
